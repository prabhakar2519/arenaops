<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
<changeSet id="R1_0-03-create-app-user" author="arena">
        <validCheckSum>9:b76ca1417e67aa38d9babe29214d2209</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${ARENA_DB_SCHEMA}" tableName="app_user"/>
            </not>
        </preConditions>
        <createSequence schemaName="${ARENA_DB_SCHEMA}" sequenceName="seq_app_user" startValue="1"/>
        <createTable schemaName="${ARENA_DB_SCHEMA}" tableName="app_user">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="username" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="display_name" type="VARCHAR(160)"/>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="parlour_id" type="BIGINT"/>
            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="last_seen_at" type="TIMESTAMP"/>
            <column name="logged_out_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
