<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">

    <changeSet id="r1-8-create-customer" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${ARENA_DB_SCHEMA}" tableName="customer"/>
            </not>
        </preConditions>
        <createSequence schemaName="${ARENA_DB_SCHEMA}" sequenceName="seq_customer" startValue="1"/>
        <createTable schemaName="${ARENA_DB_SCHEMA}" tableName="customer">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="parlour_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_name" type="VARCHAR(255)"/>
            <column name="owner_email" type="VARCHAR(255)"/>
            <column name="owner_phone" type="VARCHAR(50)"/>
            <column name="sports" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="onboarding_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="trial_starts_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="trial_ends_at" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="subscription_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="billing_amount" type="NUMERIC(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="billing_currency" type="VARCHAR(10)" defaultValue="INR">
                <constraints nullable="false"/>
            </column>
            <column name="billing_start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="next_due_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="payment_status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="access_allowed" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="notes" type="VARCHAR(1000)"/>
            <column name="created_by" type="VARCHAR(100)"/>
            <column name="payment_activated_by" type="VARCHAR(100)"/>
            <column name="payment_activated_at" type="TIMESTAMP"/>
            <column name="access_updated_by" type="VARCHAR(100)"/>
            <column name="access_updated_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="r1-8-create-customer-onboarding-code" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists schemaName="${ARENA_DB_SCHEMA}" tableName="customer_onboarding_code"/>
            </not>
        </preConditions>
        <createSequence schemaName="${ARENA_DB_SCHEMA}" sequenceName="seq_customer_onboarding_code" startValue="1"/>
        <createTable schemaName="${ARENA_DB_SCHEMA}" tableName="customer_onboarding_code">
            <column name="id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="code" type="VARCHAR(40)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="max_uses" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="used_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="TIMESTAMP"/>
            <column name="used_by_username" type="VARCHAR(100)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint baseTableSchemaName="${ARENA_DB_SCHEMA}"
                                 baseTableName="customer_onboarding_code"
                                 baseColumnNames="customer_id"
                                 constraintName="fk_onboarding_code_customer"
                                 referencedTableSchemaName="${ARENA_DB_SCHEMA}"
                                 referencedTableName="customer"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="r1-8-link-user-and-parlour-to-customer" author="codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists schemaName="${ARENA_DB_SCHEMA}" tableName="app_user" columnName="customer_id"/>
            </not>
        </preConditions>
        <addColumn tableName="app_user" schemaName="${ARENA_DB_SCHEMA}">
            <column name="customer_id" type="BIGINT"/>
        </addColumn>
        <addColumn tableName="parlour" schemaName="${ARENA_DB_SCHEMA}">
            <column name="customer_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint baseTableSchemaName="${ARENA_DB_SCHEMA}"
                                 baseTableName="app_user"
                                 baseColumnNames="customer_id"
                                 constraintName="fk_app_user_customer"
                                 referencedTableSchemaName="${ARENA_DB_SCHEMA}"
                                 referencedTableName="customer"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableSchemaName="${ARENA_DB_SCHEMA}"
                                 baseTableName="parlour"
                                 baseColumnNames="customer_id"
                                 constraintName="fk_parlour_customer"
                                 referencedTableSchemaName="${ARENA_DB_SCHEMA}"
                                 referencedTableName="customer"
                                 referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
