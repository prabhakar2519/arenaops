# Copy to application-dev.yaml and fill the SET_LOCALLY values.
ARENA_DB_HOST: localhost
ARENA_DB_NAME: arena_dev
ARENA_DB_USERNAME: SET_LOCALLY
ARENA_DB_PASSWORD: SET_LOCALLY
ARENA_DB_SCHEMA: arena_dev
KEYCLOAK_SERVER_URL: http://localhost:9091/auth
KC_AUTH_URL: http://localhost:9091/auth
KC_JWK_SET_URI: http://localhost:9091/auth/realms/arena-dev/protocol/openid-connect/certs
KEYCLOAK_BFF_SECRET: SET_LOCALLY
APP_BASE_URL: http://localhost:4200
APP_CORS_ALLOWED_ORIGINS: http://localhost:4200,http://127.0.0.1:4200,http://192.168.0.219:4200
SESSION_COOKIE_SECURE: 'false'
ARENAOPS_MAIL_ENABLED: 'true'
BREVO_SMTP_HOST: smtp-relay.brevo.com
BREVO_SMTP_PORT: '587'
BREVO_SMTP_USERNAME: SET_LOCALLY
BREVO_SMTP_PASSWORD: SET_LOCALLY
ARENAOPS_MAIL_FROM: SET_LOCALLY
ARENAOPS_MAIL_FROM_NAME: SET_LOCALLY
ARENAOPS_MAIL_REPLY_TO: SET_LOCALLY
ARENAOPS_FRONTEND_URL: http://localhost:4200
ARENAOPS_BILLING_MONTHLY: '1000'
ARENAOPS_BILLING_ANNUAL: '10000'
ARENAOPS_BILLING_TAX_RATE: '0.18'
ARENAOPS_NETWORK: arena-dev
KC_BFF_CLIENT_SECRET: SET_LOCALLY
KC_REALM: arena-dev
KC_BASE_URL: http://localhost:9091/auth
KC_ISSUER_URI: http://localhost:9091/auth/realms/arena-dev
ARENA_CORE_URL: http://localhost:7701
spring: {}
