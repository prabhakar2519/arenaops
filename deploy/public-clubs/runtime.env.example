# Provision the SAME strong random >=32-character secret into Core and Login.
# Never commit a real key. Empty/mismatched keys fail closed.
PUBLIC_CLUB_HOST_KEY=
PUBLIC_CLUB_DOMAIN=arenaops.in
PUBLIC_CLUB_SCHEME=https
PUBLIC_CLUB_PORT=
# Local isolated development: DOMAIN=arenaops.test, SCHEME=https, PORT=8443.
# DNS provider credentials belong ONLY in infrastructure's Caddy secret environment.
# NAMECHEAP_API_KEY=... / NAMECHEAP_API_USER=... / NAMECHEAP_CLIENT_IP=whitelisted-static-IP
# Core QR links use a shared application origin, independent of public club websites.
# Set ARENA_ENV to dev, sit or prod in Core and Login runtime configuration.
# Core: prefer ARENAOPS_PUBLIC_APP_URL over mail/frontend URL fallbacks.
# Local phone testing: ARENAOPS_PUBLIC_APP_URL=http://192.168.0.219:4200
# SIT: ARENAOPS_PUBLIC_APP_URL=https://sit.arenaops.in
# PROD: ARENAOPS_PUBLIC_APP_URL=https://arenaops.in
# Preserve the shared HOST_KEY and matching DOMAIN in Core/Login. No wildcard DNS required.
